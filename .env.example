# SQLite for v1. To move to Postgres later: change `provider` in prisma/schema.prisma
# to "postgresql" and point this at the Postgres URL, then run `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Single shared password for the whole team (v1).
APP_PASSWORD="change-me"

# Comma-separated list of team members. Used for owner dropdowns and "my items".
TEAM_MEMBERS="Sean,AJ,Teddy"
# Time zone used for "today" on the My day page and meeting times (IANA name).
TEAM_TIMEZONE="America/Los_Angeles"

# Secret used to sign the session cookie: at least 32 random characters (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Extra hosts the My day calendar link may point at (Outlook and Google hosts are always allowed).
# CALENDAR_HOSTS=""

# Where uploaded documents and import workbooks are stored on disk.
STORAGE_DIR="./storage"
